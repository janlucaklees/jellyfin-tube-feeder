[Unit]
Description=Tube Feeder's Ollama (the tagging model, CPU only)

[Container]
Image=docker.io/ollama/ollama:0.40.13
ContainerName=tubefeeder-ollama
Pod=tubefeeder.pod
Environment=TZ={{ tz }}
{# Pod-internal only: the app reaches it on the pod's loopback. #}
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MAX_LOADED_MODELS=1
{# Frees the model's memory (~6 GB) five minutes after the last song. #}
Environment=OLLAMA_KEEP_ALIVE=5m
Volume={{ volumes.ollama }}:/root/.ollama
HealthCmd=ollama list
HealthStartPeriod=30s
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
